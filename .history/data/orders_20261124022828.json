[import { createClient } from "@supabase/supabase-js";

const supabase = createClient(
  process.env.SUPABASE_URL,
  process.env.SUPABASE_SERVICE_ROLE_KEY
);

export default async function handler(req, res) {
  if (req.method !== "POST") {
    return res.status(405).json({ error: "Method not allowed" });
  }

  try {
    const {
      customerName,
      phone,
      packageId,
      currency,
      amount
    } = req.body || {};

    if (!customerName || !phone || !packageId || !currency) {
      return res.status(400).json({
        error: "Missing required checkout information."
      });
    }

    if (!Number.isFinite(Number(amount)) || Number(amount) <= 0) {
      return res.status(400).json({
        error: "Invalid checkout amount."
      });
    }

    const reference =
      "AT-" + Date.now().toString(36).toUpperCase() +
      "-" + Math.random().toString(36).slice(2, 8).toUpperCase();

    const order = {
      reference,
      customer_name: String(customerName).trim(),
      phone: String(phone).trim(),
      package_id: String(packageId),
      currency: String(currency).toUpperCase(),
      amount: Number(amount),
      payment_status: "DEMO_RECORDED"
    };

    const { data, error } = await supabase
      .from("orders")
      .insert(order)
      .select("reference")
      .single();

    if (error) {
      console.error("Supabase order error:", error);
      return res.status(500).json({
        error: "Could not save your order."
      });
    }

    return res.status(201).json({
      success: true,
      order: {
        reference: data.reference
      }
    });

  } catch (error) {
    console.error("Order API error:", error);

    return res.status(500).json({
      error: "Server error while recording order."
    });
  }
}